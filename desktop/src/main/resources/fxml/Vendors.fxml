<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="25"
      styleClass="page-container">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5">

            <Label text="Vendors"
                   styleClass="section-title"/>

            <Label text="Manage suppliers and vendor information."
                   styleClass="page-description"/>

        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button text="+ Add Vendor"
                styleClass="primary-button"/>

    </HBox>

    <TableView VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn text="Vendor"
                         prefWidth="250"/>

            <TableColumn text="Contact"
                         prefWidth="200"/>

            <TableColumn text="Email"
                         prefWidth="250"/>

            <TableColumn text="Category"
                         prefWidth="180"/>

            <TableColumn text="Status"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>