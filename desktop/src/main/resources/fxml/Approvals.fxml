<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="25"
      styleClass="page-container">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <VBox spacing="5">

        <Label text="Approvals"
               styleClass="section-title"/>

        <Label text="Review and approve pending financial transactions."
               styleClass="page-description"/>

    </VBox>

    <TableView VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn text="Request"
                         prefWidth="250"/>

            <TableColumn text="Requested By"
                         prefWidth="180"/>

            <TableColumn text="Date"
                         prefWidth="140"/>

            <TableColumn text="Amount"
                         prefWidth="150"/>

            <TableColumn text="Status"
                         prefWidth="150"/>

            <TableColumn text="Action"
                         prefWidth="180"/>

        </columns>

    </TableView>

</VBox>