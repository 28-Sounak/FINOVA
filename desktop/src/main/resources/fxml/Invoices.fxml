<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="25"
      styleClass="page-container">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5">

            <Label text="Invoices"
                   styleClass="section-title"/>

            <Label text="Create, manage and track invoices."
                   styleClass="page-description"/>

        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button text="+ Create Invoice"
                styleClass="primary-button"/>

    </HBox>

    <TableView VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn text="Invoice ID"
                         prefWidth="150"/>

            <TableColumn text="Customer"
                         prefWidth="250"/>

            <TableColumn text="Issue Date"
                         prefWidth="140"/>

            <TableColumn text="Due Date"
                         prefWidth="140"/>

            <TableColumn text="Status"
                         prefWidth="150"/>

            <TableColumn text="Amount"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>s