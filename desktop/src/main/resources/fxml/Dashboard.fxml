<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.invoiceautomation.controllers.DashboardController">

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="14" right="22" bottom="14" left="22"/>
            </padding>

            <!-- FINOVA Navigation -->

            <MenuButton text="FINOVA ▾"
                        styleClass="brand-menu">

                <items>

                    <MenuItem text="Dashboard"
                              onAction="#openDashboard"/>

                    <MenuItem text="Expenses"
                              onAction="#openExpenses"/>

                    <MenuItem text="Invoices"
                              onAction="#openInvoices"/>

                    <MenuItem text="Vendors"
                              onAction="#openVendors"/>

                    <MenuItem text="Approvals"
                              onAction="#openApprovals"/>

                    <MenuItem text="Reports"
                              onAction="#openReports"/>

                    <MenuItem text="Settings"
                              onAction="#openSettings"/>

                </items>

            </MenuButton>

            <Label fx:id="pageTitle"
                   text="Dashboard"
                   styleClass="page-title"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <!-- User Menu -->

            <MenuButton text="User ▾"
                        styleClass="user-menu">

                <items>

                    <MenuItem text="Profile"
                              onAction="#openProfile"/>

                    <MenuItem text="Preferences"
                              onAction="#openPreferences"/>

                    <MenuItem text="Logout"
                              onAction="#logout"/>

                </items>

            </MenuButton>

        </HBox>

    </top>

    <center>

        <VBox spacing="25"
              styleClass="dashboard"
              fillWidth="true">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- Welcome -->

            <VBox spacing="5">

                <Label text="Welcome back"
                       styleClass="welcome-title"/>

                <Label text="Here's an overview of your financial activity."
                       styleClass="welcome-subtitle"/>

            </VBox>

            <!-- Summary Cards -->

            <HBox spacing="20">

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Total Expenses"
                           styleClass="card-label"/>

                    <Label text="₹0.00"
                           styleClass="card-value"/>

                    <Label text="This month"
                           styleClass="card-description"/>

                </VBox>

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Pending Invoices"
                           styleClass="card-label"/>

                    <Label text="0"
                           styleClass="card-value"/>

                    <Label text="Awaiting payment"
                           styleClass="card-description"/>

                </VBox>

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Pending Approvals"
                           styleClass="card-label"/>

                    <Label text="0"
                           styleClass="card-value"/>

                    <Label text="Requires attention"
                           styleClass="card-description"/>

                </VBox>

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Vendors"
                           styleClass="card-label"/>

                    <Label text="0"
                           styleClass="card-value"/>

                    <Label text="Active vendors"
                           styleClass="card-description"/>

                </VBox>

            </HBox>

            <!-- Recent Transactions -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <Label text="Recent Transactions"
                           styleClass="section-title"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Button text="View All"
                            styleClass="secondary-button"/>

                </HBox>

                <TableView VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn text="Date"
                                     prefWidth="150"/>

                        <TableColumn text="Description"
                                     prefWidth="300"/>

                        <TableColumn text="Category"
                                     prefWidth="180"/>

                        <TableColumn text="Type"
                                     prefWidth="130"/>

                        <TableColumn text="Amount"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>